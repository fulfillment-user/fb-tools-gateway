# Copy to .env (never commit the real .env -- it's gitignored) and fill in.

# Random long string used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Image tag your fb-rate-engine pipeline pushes the quotation-tool build to,
# e.g. europe-west1-docker.pkg.dev/YOUR_PROJECT/fb-images/quotation-tool:latest
QUOTATION_TOOL_IMAGE=

# Copy to .env (never commit the real .env -- it's gitignored) and fill in.
# Used by docker-compose.yml directly, and by scripts/build_and_deploy.py
# (REGISTRY only) if you export these into the pipeline's environment
# instead of managing them through your normal secrets mechanism -- see
# docs/DEVOPS_HANDOFF.md.

# Where scripts/build_and_deploy.py pushes every app's image, e.g.
# europe-west1-docker.pkg.dev/YOUR_PROJECT/fb-tools
REGISTRY=

# Random long string used to sign login session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Leads CRM's "Suggest follow-up" feature. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
